generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InquiryStatus {
  PENDING
  COMPLETED
}

enum ResponseMethod {
  EMAIL
  PHONE
  TEXT
  BOTH
  ANY
}

enum CustomerDuplicateReviewStatus {
  PENDING
  LINKED
  KEPT_SEPARATE
  MERGED
}

model Inquiry {
  id                   String                 @id @default(cuid())
  registrationNumber   String                 @unique
  companyName          String
  contactPerson        String
  email                String?
  phone                String?
  responseMethod       ResponseMethod         @default(ANY)
  inquiryType          String                 @default("일반 제품 문의")
  department           String?
  inquiryDetails       Json?
  country              String?
  industry             String?
  currentPalletType    String?
  productInterest      String?
  cargoType            String?
  loadPerPallet        String?
  estimatedQuantity    String?
  requiredPalletSize   String?
  requestedPalletSizes String[]               @default([])
  exportCountry        String?
  rackStorage          Boolean?
  automationUse        Boolean?
  forkliftUse          Boolean?
  handPalletTruckUse   Boolean?
  message              String?                @db.VarChar(1500)
  status               InquiryStatus          @default(PENDING)
  adminMemo            String?
  assignedAdminId      String?
  customerId           String
  assignedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  assignedAdmin        AdminUser?             @relation("InquiryAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  customer             Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  completionLogs       InquiryCompletionLog[]
  assignmentLogs       InquiryAssignmentLog[]
  attachments          InquiryAttachment[]

  @@index([assignedAdminId, status, createdAt])
  @@index([customerId, status, createdAt])
}

model InquiryAttachment {
  id          String   @id @default(cuid())
  inquiryId   String
  fileName    String
  contentType String
  size        Int
  storagePath String   @unique
  createdAt   DateTime @default(now())
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model AdminUser {
  id                String                 @id @default(cuid())
  username          String                 @unique
  passwordHash      String
  displayName       String?
  isActive          Boolean                @default(true)
  isSuperAdmin      Boolean                @default(false)
  isAssistantAdmin  Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  devices           AdminDevice[]
  assignedInquiries Inquiry[]              @relation("InquiryAssignee")
  completionLogs    InquiryCompletionLog[]
  assignmentLogs    InquiryAssignmentLog[]
  customerFavorites CustomerFavorite[]
}

model Company {
  id             String     @id @default(cuid())
  name           String
  normalizedName String     @unique
  memo           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  customers      Customer[]
}

model Customer {
  id                 String                    @id @default(cuid())
  name               String
  phone              String?
  normalizedPhone    String?
  email              String?
  normalizedEmail    String?
  memo               String?
  companyId          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  company            Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  inquiries          Inquiry[]
  favorites          CustomerFavorite[]
  duplicateReviews   CustomerDuplicateReview[] @relation("DuplicateReviewNewCustomer")
  candidateForReview CustomerDuplicateReview[] @relation("DuplicateReviewCandidateCustomer")

  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([companyId])
  @@index([createdAt])
}

model CustomerFavorite {
  adminUserId String
  customerId  String
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([adminUserId, customerId])
  @@index([customerId])
}

model CustomerDuplicateReview {
  id                    String                        @id @default(cuid())
  newCustomerId         String
  candidateCustomerId   String
  matchedPhone          Boolean                       @default(false)
  matchedEmail          Boolean                       @default(false)
  matchedCompany        Boolean                       @default(false)
  status                CustomerDuplicateReviewStatus @default(PENDING)
  resolvedByAdminId     String?
  resolvedByDisplayName String?
  resolvedAt            DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  newCustomer           Customer                      @relation("DuplicateReviewNewCustomer", fields: [newCustomerId], references: [id], onDelete: Cascade)
  candidateCustomer     Customer                      @relation("DuplicateReviewCandidateCustomer", fields: [candidateCustomerId], references: [id], onDelete: Cascade)

  @@unique([newCustomerId, candidateCustomerId])
  @@index([status, createdAt])
  @@index([candidateCustomerId])
}

model InquiryCompletionLog {
  id               String     @id @default(cuid())
  inquiryId        String
  adminUserId      String?
  adminUsername    String
  adminDisplayName String?
  completedAt      DateTime   @default(now())
  inquiry          Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  adminUser        AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([completedAt])
  @@index([inquiryId])
  @@index([adminUserId])
}

model InquiryAssignmentLog {
  id                       String     @id @default(cuid())
  inquiryId                String
  adminUserId              String?
  adminUsername            String
  adminDisplayName         String?
  assignedAdminId          String?
  assignedAdminDisplayName String?
  createdAt                DateTime   @default(now())
  inquiry                  Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  adminUser                AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([inquiryId])
  @@index([adminUserId])
}

model AdminDevice {
  id          String    @id @default(cuid())
  adminUserId String
  token       String    @unique
  platform    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

enum WebsiteAssetType {
  IMAGE
  PDF
  VIDEO
}

model WebsiteSection {
  key           String         @id
  title         String
  requiredCount Int            @default(0)
  data          Json?
  updatedById   String?
  updatedByName String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assets        WebsiteAsset[]
}

model WebsiteAsset {
  id                  String           @id @default(cuid())
  sectionKey          String
  itemKey             String
  label               String
  type                WebsiteAssetType
  url                 String?
  originalUrl         String?
  storagePath         String?
  originalStoragePath String?
  originalFileName    String?
  storedFileName      String?
  mimeType            String?
  size                Int?
  width               Int?
  height              Int?
  cropX               Float?
  cropY               Float?
  cropWidth           Float?
  cropHeight          Float?
  zoom                Float?
  rotation            Int?
  aspectRatio         String?
  outputWidth         Int?
  outputHeight        Int?
  sortOrder           Int              @default(0)
  published           Boolean          @default(true)
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  section             WebsiteSection   @relation(fields: [sectionKey], references: [key], onDelete: Cascade)

  @@index([sectionKey, itemKey, sortOrder])
}

model WebsiteChangeLog {
  id               String   @id @default(cuid())
  sectionKey       String
  sectionTitle     String
  action           String
  adminUserId      String
  adminUsername    String
  adminDisplayName String?
  previousData     Json?
  newData          Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([sectionKey])
}
